# ==== CareerAI Platform — переменные окружения ====
# Скопируйте в .env и заполните своими значениями.
# ⚠️ НИКОГДА не коммитьте .env в git!

# --- App ---
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=7777

# --- PostgreSQL (для docker-compose) ---
# Обязательно замените на сложные уникальные значения!
POSTGRES_USER=careerai
POSTGRES_PASSWORD=<сгенерируйте сложный пароль>
POSTGRES_DB=careerai

# --- Database URL ---
# В docker-compose хост = db; для локальной разработки — localhost
DATABASE_URL=postgresql+psycopg2://careerai:<пароль>@db:5432/careerai

# --- Security (обязательно заменить в проде!) ---
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<сгенерируйте уникальный ключ>
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=true

# --- Domain (HTTPS / nginx) ---
DOMAIN=<ваш-домен.example.org>

# --- Storage ---
MEDIA_DIR=media
MODELS_DIR=models

# --- Initial admin (создаётся при первом сиде) ---
# Обязательно замените пароль после первого входа!
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<сложный пароль админа>
